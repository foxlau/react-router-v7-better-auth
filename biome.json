{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/.agents/**/*",
			"!**/.react-router/**/*",
			"!**/drizzle/meta/**/*",
			"!**/drizzle/migrations/**/*",
			"!**/public/**/*",
			"!**/docs/**/*",
			"!**/app/components/ui/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noArrayIndexKey": "off"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "error",
					"fix": "safe"
				}
			},
			"a11y": {
				"noRedundantRoles": "off",
				"useSemanticElements": "off",
				"useKeyWithClickEvents": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"formatter": {
			"enabled": true
		},
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"tailwind": {
		"attributes": ["class", "className"],
		"mergeFunctions": ["cn", "tw", "clsx", "twMerge"],
		"variantFunctions": ["cva"]
	}
}
