{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"typegen": "wrangler types && react-router typegen",
		"deploy": "react-router build && WRANGLER_SEND_METRICS=false wrangler deploy",
		"deploy:version": "react-router build && wrangler versions upload",
		"deploy:promote": "wrangler versions deploy",
		"dev": "react-router dev",
		"postinstall": "wrangler types",
		"preview": "react-router build && vite preview",
		"typecheck": "wrangler types && react-router typegen && tsc -b && tsc -p tsconfig.test.json",
		"test": "bun test",
		"check": "biome check .",
		"check:fix": "biome check --fix .",
		"format": "biome format --write .",
		"auth:secret": "bunx @better-auth/cli@latest secret",
		"auth:generate": "bunx @better-auth/cli@latest generate --config=./app/services/auth/auth.server.ts --output=./app/services/db/schema/auth.ts",
		"db:generate": "drizzle-kit generate",
		"db:drop": "drizzle-kit drop",
		"db:seed:local": "wrangler d1 execute DB --local --file ./drizzle/seed/seed.sql",
		"db:seed:remote": "wrangler d1 execute DB --remote --file ./drizzle/seed/seed.sql",
		"db:reset:local": "wrangler d1 execute DB --local --file ./drizzle/seed/reset.sql",
		"db:delete:local": "rm -i ./.wrangler/state/v3/d1/miniflare-D1DatabaseObject/* || true",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@conform-to/react": "^1.21.2",
		"@conform-to/zod": "^1.21.2",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@origin-space/image-cropper": "^0.1.9",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-collapsible": "^1.2.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-select": "^2.4.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slider": "^1.6.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"better-auth": "^1.7.12",
		"boring-avatars": "^2.0.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cookie": "^2.0.1",
		"drizzle-orm": "~0.45.4",
		"isbot": "^5.2.2",
		"lucide-react": "^1.61.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.0",
		"sonner": "^2.0.8",
		"spin-delay": "^2.0.1",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@cloudflare/vite-plugin": "1.64.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@react-router/dev": "^8.5.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "^0.31.11",
		"lefthook": "^2.2.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"wrangler": "4.152.0"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		},
		"browserslist": "^4.29.4",
		"fast-uri": "^3.1.8",
		"js-yaml": "^4.3.2",
		"undici": "^7.30.1"
	},
	"trustedDependencies": [
		"esbuild",
		"lefthook",
		"sharp",
		"workerd"
	]
}
